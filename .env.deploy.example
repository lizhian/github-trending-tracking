# Copy to .env.deploy.local; retain resource IDs locally, credentials in Wrangler.
CLOUDFLARE_ACCOUNT_ID=replace-with-account-id
CLOUDFLARE_D1_DATABASE_ID=replace-with-existing-database-uuid
ALLOWED_ORIGIN=https://github.lizhian.cc.cd
CLOUDFLARE_ZONE_NAME=lizhian.cc.cd
CLOUDFLARE_PAGES_PROJECT_NAME=github-trending-tracking
CLOUDFLARE_PAGES_BRANCH=main
# Optional: keep the real URL only in .env.deploy.local; deploy writes a Worker Secret.
LINUXDO_RSS_FALLBACK_URL=
